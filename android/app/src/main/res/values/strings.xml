    <!-- How to play -->
    <string name="tut_goal_heading">The goal</string>
    <string name="tut_goal_body">Every line of the grid is a regular expression. Fill the cells so that each line, read in its own direction, matches its clue exactly \u2014 a whole-string match.</string>
    <string name="tut_grids_heading">Grids</string>
    <string name="tut_rect_term">Rectangle (Easy)</string>
    <string name="tut_rect_body">each row reads left to right; each column reads top to bottom.</string>
    <string name="tut_hex_term">Hexagon (Medium / Hard)</string>
    <string name="tut_hex_body">three colour-coded directions. The arrow beside a clue shows where it reads from; the cell ringed in that colour is the first cell of the line.</string>
    <string name="tut_x_term">X \u00B7 blue</string>
    <string name="tut_x_body">read bottom to top (up arrow).</string>
    <string name="tut_y_term">Y \u00B7 green</string>
    <string name="tut_y_body">read left to right (right arrow).</string>
    <string name="tut_z_term">Z \u00B7 red</string>
    <string name="tut_z_body">read top to bottom (down arrow).</string>
    <string name="tut_controls_heading">Controls</string>
    <string name="tut_tap_term">Tap a cell</string>
    <string name="tut_tap_body">then tap a letter to fill it; backspace clears it.</string>
    <string name="tut_hint_term">Hint</string>
    <string name="tut_hint_body">reveals one cell from a completion consistent with what you have entered.</string>
    <string name="tut_givens_term">Givens</string>
    <string name="tut_givens_body">fills cells whose letter a clue literally writes down at a fixed position (no search).</string>
    <string name="tut_notes_term">Notes</string>
    <string name="tut_notes_body">toggles pencil marks: tap letters to add or remove candidates.</string>
    <string name="tut_clear_term">Clear</string>
    <string name="tut_clear_body">erases the grid, after asking.</string>
    <string name="tut_solve_term">Solve</string>
    <string name="tut_solve_body">menu (top right) \u2014 fills one valid solution after confirming.</string>
    <string name="tut_undo_term">Undo / Redo</string>
    <string name="tut_undo_body">top bar \u21B6 \u21B7 arrows \u2014 step through your edits.</string>
    <string name="tut_difficulty_heading">Difficulty</string>
    <string name="tut_easy_term">Easy</string>
    <string name="tut_easy_body">rectangle, 5\u00D75.</string>
    <string name="tut_medium_term">Medium</string>
    <string name="tut_medium_body">hexagon with loose clues \u2014 several valid solutions.</string>
    <string name="tut_hard_term">Hard</string>
    <string name="tut_hard_body">hexagon with a unique solution, pre-generated with the solver.</string>
    <string name="tut_saved_body">Progress and the timer are saved automatically for every level.</string>

    <!-- License / Credits -->
    <string name="license_heading">MIT License</string>
